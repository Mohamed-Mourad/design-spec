{
  "name": "design-spec",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "build:compiler": "npm run build --workspace @design-spec/compiler",
    "publish:compiler": "npm publish --workspace @design-spec/compiler"
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "@unhead/vue": "^3.1.1",
    "class-variance-authority": "^0.7.1",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "pinia": "^3.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.7",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.2.8"
  }
}
