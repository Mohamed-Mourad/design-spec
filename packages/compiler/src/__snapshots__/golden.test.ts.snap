[
  {
    "content": "// Generated by design-spec — do not edit by hand.
// Source of truth: design-spec.schema.json. Run \`design-spec compile\` to regenerate.

import 'package:flutter/material.dart';

import '../../theme/app_colors.dart';
import '../../theme/app_spacing.dart';
import '../../theme/app_typography.dart';

enum ButtonVariant { primary, secondary, ghost, destructive }

enum ButtonSize { sm, md, lg }

/// Primary action trigger. The most-referenced component in any UI.
class Button extends StatelessWidget {
  const Button({
    super.key,
    this.variant = ButtonVariant.primary,
    this.size = ButtonSize.md,
    this.disabled = false,
    this.loading = false,
    required this.label,
    this.onPressed,
  });

  final ButtonVariant variant;
  final ButtonSize size;
  final bool disabled;
  final bool loading;
  /// Button text
  final String label;
  final VoidCallback? onPressed;

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final t = _ButtonTokens.resolve(variant, constraints.maxWidth);
        final box = Container(
          padding: EdgeInsets.symmetric(horizontal: t.paddingX ?? 0, vertical: t.paddingY ?? 0),
          decoration: BoxDecoration(
            color: t.backgroundColor,
            borderRadius: BorderRadius.circular(t.radius ?? 0),
            border: t.borderColor == null ? null : Border.all(color: t.borderColor!, width: t.borderWidth ?? 1),
          ),
          child: DefaultTextStyle.merge(style: (t.textStyle ?? const TextStyle()).copyWith(color: t.textColor), child: loading ? const SizedBox.square(dimension: 16, child: CircularProgressIndicator(strokeWidth: 2)) : const SizedBox.shrink()),
        );
        final enabled = onPressed != null && !disabled && !loading;
        return Semantics(
          button: true,
          enabled: enabled,
          child: MouseRegion(
            cursor: enabled ? SystemMouseCursors.click : SystemMouseCursors.basic,
            child: GestureDetector(onTap: enabled ? onPressed : null, child: box),
          ),
        );
      },
    );
  }
}

/// Button's design tokens: base, per-variant and per-breakpoint overrides.
class _ButtonTokens {
