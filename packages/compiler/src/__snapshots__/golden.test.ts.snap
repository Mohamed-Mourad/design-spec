/** @type {import("tailwindcss").Config} */
export default {
  prefix: '',
  content: ['./src/**/*.{js,ts,jsx,tsx,vue,html}'],
  theme: {
    extend: {
      screens: {
        'tablet': '768px',
        'desktop': '1024px',
        'wide': '1280px',
      },
