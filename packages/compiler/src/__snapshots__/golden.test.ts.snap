import React from 'react'

export type ButtonVariant = 'primary' | 'secondary' | 'ghost' | 'destructive'

export interface ButtonProps extends React.ButtonHTMLAttributes<HTMLButtonElement> {
  variant?: ButtonVariant
  size?: 'sm' | 'md' | 'lg'
  disabled?: boolean
  loading?: boolean
  label: string
}

const base = 'bg-primary text-on-primary text-label-lg rounded-md px-md py-sm'

const variants: Record<ButtonVariant, string> = {
  primary: '',
  secondary: 'bg-surface-raised text-on-surface border-surface-border border-[1px]',
  ghost: 'text-on-surface-muted',
  destructive: 'bg-status-error text-on-primary',
}

export function Button({ variant = 'primary', className, ...props }: ButtonProps) {
  const classes = [base, variants[variant], className].filter(Boolean).join(' ')
  return <button className={classes} {...props} />
}
",
