    "content": "// Generated by design-spec — do not edit by hand.
// Source of truth: design-spec.schema.json. Run \`design-spec compile\` to regenerate.

import 'package:flutter/material.dart';

import '../../theme/app_colors.dart';
import '../../theme/app_spacing.dart';

enum DrawerSide { left, right, bottom }

/// Panel that slides in from the left, right, or bottom over an overlay. Becomes a bottom sheet on small screens.
class Drawer extends StatelessWidget {
  const Drawer({
    super.key,
    this.side = DrawerSide.right,
    this.open = false,
    this.title,
    this.child,
  });

  final DrawerSide side;
  final bool open;
  final String? title;
  /// Drawer body
  final Widget? child;

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final t = _DrawerTokens.resolve(constraints.maxWidth);
        final box = Container(
          width: t.width,
          padding: EdgeInsets.symmetric(horizontal: t.padding ?? 0, vertical: t.padding ?? 0),
          decoration: BoxDecoration(
            color: t.backgroundColor,
            boxShadow: t.shadow,
          ),
          child: DefaultTextStyle.merge(style: TextStyle(color: t.textColor), child: child ?? const SizedBox.shrink()),
        );
        return box;
      },
    );
  }
}

/// Drawer's design tokens: base, per-variant and per-breakpoint overrides.
class _DrawerTokens {
  const _DrawerTokens({this.backgroundColor, this.textColor, this.shadow, this.padding, this.width});

  final Color? backgroundColor;
  final Color? textColor;
  final List<BoxShadow>? shadow;
  final double? padding;
  final double? width;

  _DrawerTokens merge(_DrawerTokens o) => _DrawerTokens(
        backgroundColor: o.backgroundColor ?? backgroundColor,
        textColor: o.textColor ?? textColor,
        shadow: o.shadow ?? shadow,
        padding: o.padding ?? padding,
        width: o.width ?? width,
      );

  static const base = _DrawerTokens(
    backgroundColor: AppColors.surfaceDefault,
    textColor: AppColors.onSurface,
    shadow: AppShadows.xl,
    padding: AppSpacing.lg,
    width: 320,
  );

  /// Mobile-first cascade: base, then each breakpoint the width reaches.
  static _DrawerTokens resolve(double width) {
    return base;
  }
}
",
    "filename": "lib/widgets/Drawer/drawer.dart",
    "language": "dart",
  },
]
`;

