exports[`golden — Vue+Tailwind components > default schema 1`] = `
[
  {
    "content": "<!-- Generated by design-spec — do not edit by hand. -->
<!-- Source of truth: design-spec.schema.json. Run \`design-spec compile\` to regenerate. -->

<script setup lang="ts">
import { computed } from 'vue'
const props = withDefaults(defineProps<{
  variant?: 'primary' | 'secondary'
  variant?: 'primary' | 'secondary'
  size?: 'sm' | 'md' | 'lg'
  disabled?: boolean
  loading?: boolean
}>(), { variant: 'primary' })
const variantClasses: Record<string, string> = {
  primary: '',
  secondary: 'bg-surface text-primary border-border border-thin',
}
const classes = computed(() => 'bg-primary text-surface text-label-md rounded-md px-md py-sm' + ' ' + (variantClasses[props.variant ?? 'primary'] ?? ''))
</script>

<template>
  <button :class="classes">
    <slot />
  </button>
</template>
",
    "filename": "components/vue-tailwind/Button.vue",
    "language": "vue",
  },
  {
    "content": "<!-- Generated by design-spec — do not edit by hand. -->
<!-- Source of truth: design-spec.schema.json. Run \`design-spec compile\` to regenerate. -->

<script setup lang="ts">
defineProps<{
  label?: string
  placeholder?: string
  disabled?: boolean
  error?: string
}>()
</script>

<template>
  <input class="bg-surface text-on-surface text-body-md border-border border-thin rounded-md px-md py-sm" />
</template>
",
    "filename": "components/vue-tailwind/Input.vue",
    "language": "vue",
  },
]
`;

