  {
    "content": "/* Generated by design-spec — do not edit by hand. */
/* Source of truth: design-spec.schema.json. Run \`design-spec compile\` to regenerate. */
:root {
  --color-primary: #2563EB;
  --color-secondary: #475569;
  --color-neutral: #0F172A;
  --color-surface: #FFFFFF;
  --color-on-surface: #0F172A;
  --color-muted: #64748B;
  --color-border: #E2E8F0;
  --color-error: #DC2626;
  --color-success: #16A34A;
  --spacing-base: 16px;
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 16px;
  --spacing-lg: 24px;
  --spacing-xl: 40px;
  --spacing-2xl: 64px;
  --rounded-none: 0px;
  --rounded-sm: 4px;
  --rounded-md: 8px;
