  button-primary:
    backgroundColor: "{colors.primary}"
    textColor: "{colors.surface}"
    rounded: "{rounded.md}"
    paddingX: "{spacing.md}"
    paddingY: "{spacing.sm}"
    typography: "{typography.label-md}"
