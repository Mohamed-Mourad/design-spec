import 'package:flutter/material.dart';

import '../../theme/app_colors.dart';
import '../../theme/app_spacing.dart';

enum StatCardTrend { up, down, flat }

enum StatCardTone { defaultToken, accent }

/// A KPI tile.
class StatCard extends StatelessWidget {
  const StatCard({
    super.key,
    required this.value,
    this.trend,
    this.tone = StatCardTone.defaultToken,
    this.precision = 2,
    required this.caption,
    this.icon,
    this.inToken = true,
    required this.child,
    this.loose,
  });

  final double value;
  final StatCardTrend? trend;
  final StatCardTone tone;
  final double precision;
  /// Label under the value.
  final String caption;
  final Widget? icon;
  final bool inToken;
  final Widget child;
  final String? loose;

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        if (!_StatCardTokens.visibleAt(constraints.maxWidth)) return const SizedBox.shrink();
        final t = _StatCardTokens.resolve(constraints.maxWidth);
        final box = Container(
          width: t.size,
          height: t.size,
          padding: EdgeInsets.symmetric(horizontal: t.padding ?? 0, vertical: t.padding ?? 0),
          decoration: BoxDecoration(
            color: t.backgroundColor,
            borderRadius: BorderRadius.circular(t.radius ?? 0),
            border: t.borderColor == null ? null : Border.all(color: t.borderColor!, width: 1),
            boxShadow: t.shadow,
          ),
          child: DefaultTextStyle.merge(style: TextStyle(color: t.textColor), child: child),
        );
        return box;
      },
    );
  }
}

/// StatCard's design tokens: base, per-variant and per-breakpoint overrides.
class _StatCardTokens {
  const _StatCardTokens({this.backgroundColor, this.textColor, this.borderColor, this.radius, this.shadow, this.padding, this.size});

  final Color? backgroundColor;
  final Color? textColor;
  final Color? borderColor;
  final double? radius;
  final List<BoxShadow>? shadow;
  final double? padding;
  final double? size;

  _StatCardTokens merge(_StatCardTokens o) => _StatCardTokens(
        backgroundColor: o.backgroundColor ?? backgroundColor,
        textColor: o.textColor ?? textColor,
        borderColor: o.borderColor ?? borderColor,
        radius: o.radius ?? radius,
        shadow: o.shadow ?? shadow,
        padding: o.padding ?? padding,
        size: o.size ?? size,
      );

  static const base = _StatCardTokens(
    backgroundColor: AppColors.surface,
    textColor: Color(0xFF123456),
    borderColor: AppColors.border,
    radius: 12,
    shadow: AppShadows.md,
    padding: AppSpacing.lg,
    size: 96,
  );
  static const atDesktop = _StatCardTokens(
    shadow: [BoxShadow(color: Color(0x33000000), offset: Offset(0, 2), blurRadius: 4, spreadRadius: 0)],
  );

  /// Mobile-first cascade: base, then each breakpoint the width reaches.
  static _StatCardTokens resolve(double width) {
    var t = base;
    if (width >= AppBreakpoints.desktop) t = t.merge(atDesktop);
    // TODO: breakpoint "mystery" is not in schema.breakpoints — skipped.
    return t;
  }

  static bool visibleAt(double width) {
    var visible = true;
    if (width >= AppBreakpoints.tablet) visible = false;
    if (width >= AppBreakpoints.desktop) visible = true;
    return visible;
  }
}
",
