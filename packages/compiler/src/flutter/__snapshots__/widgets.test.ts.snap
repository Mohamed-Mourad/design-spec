import 'package:flutter/material.dart';

import '../../theme/app_colors.dart';
import '../../theme/app_spacing.dart';
import '../../theme/app_typography.dart';

/// A single-line text field with label, helper text, and error states.
class Input extends StatelessWidget {
  const Input({
    super.key,
    this.label,
    this.placeholder,
    this.disabled = false,
    this.error,
    this.controller,
    this.onChanged,
  });

  final String? label;
  final String? placeholder;
  final bool disabled;
  /// Error message; switches the field to its error state.
  final String? error;
  final TextEditingController? controller;
  final ValueChanged<String>? onChanged;

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final t = _InputTokens.resolve(constraints.maxWidth);
        final border = OutlineInputBorder(borderRadius: BorderRadius.circular(t.radius ?? 0), borderSide: t.borderColor == null ? BorderSide.none : BorderSide(color: t.borderColor!, width: t.borderWidth ?? 1));
        final field = TextField(
          controller: controller,
          onChanged: onChanged,
          enabled: !disabled,
          style: (t.textStyle ?? const TextStyle()).copyWith(color: t.textColor),
          decoration: InputDecoration(
            labelText: label,
            hintText: placeholder,
            errorText: error,
            filled: t.backgroundColor != null,
            fillColor: t.backgroundColor,
            contentPadding: EdgeInsets.symmetric(horizontal: t.paddingX ?? 0, vertical: t.paddingY ?? 0),
            border: border,
            enabledBorder: border,
          ),
        );
        return field;
      },
    );
  }
}

/// Input's design tokens: base, per-variant and per-breakpoint overrides.
class _InputTokens {
  const _InputTokens({this.backgroundColor, this.textColor, this.textStyle, this.borderColor, this.borderWidth, this.radius, this.paddingX, this.paddingY});

  final Color? backgroundColor;
  final Color? textColor;
  final TextStyle? textStyle;
  final Color? borderColor;
  final double? borderWidth;
  final double? radius;
  final double? paddingX;
  final double? paddingY;

  _InputTokens merge(_InputTokens o) => _InputTokens(
        backgroundColor: o.backgroundColor ?? backgroundColor,
        textColor: o.textColor ?? textColor,
        textStyle: o.textStyle ?? textStyle,
        borderColor: o.borderColor ?? borderColor,
        borderWidth: o.borderWidth ?? borderWidth,
        radius: o.radius ?? radius,
        paddingX: o.paddingX ?? paddingX,
        paddingY: o.paddingY ?? paddingY,
      );

  static const base = _InputTokens(
    backgroundColor: AppColors.surface,
    textColor: AppColors.onSurface,
    textStyle: AppTypography.bodyMd,
    borderColor: AppColors.border,
    borderWidth: AppBorders.thin,
    radius: AppRadius.md,
    paddingX: AppSpacing.md,
    paddingY: AppSpacing.sm,
  );

  /// Mobile-first cascade: base, then each breakpoint the width reaches.
  static _InputTokens resolve(double width) {
