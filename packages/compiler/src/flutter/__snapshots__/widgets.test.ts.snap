import 'package:flutter/material.dart';

import '../../theme/app_colors.dart';
import '../../theme/app_spacing.dart';
import '../../theme/app_typography.dart';

enum ButtonVariant { primary, secondary }

enum ButtonSize { sm, md, lg }

/// A clickable action trigger. Primary drives the single most important action per view.
class Button extends StatelessWidget {
  const Button({
    super.key,
    this.variant = ButtonVariant.primary,
    this.size = ButtonSize.md,
    this.disabled = false,
    this.loading = false,
    this.child,
    this.onPressed,
  });

  final ButtonVariant variant;
  final ButtonSize size;
  final bool disabled;
  final bool loading;
  /// Button label content.
  final Widget? child;
  final VoidCallback? onPressed;

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final t = _ButtonTokens.resolve(variant, constraints.maxWidth);
        final box = Container(
          padding: EdgeInsets.symmetric(horizontal: t.paddingX ?? 0, vertical: t.paddingY ?? 0),
          decoration: BoxDecoration(
            color: t.backgroundColor,
            borderRadius: BorderRadius.circular(t.radius ?? 0),
            border: t.borderColor == null ? null : Border.all(color: t.borderColor!, width: t.borderWidth ?? 1),
          ),
          child: DefaultTextStyle.merge(style: (t.textStyle ?? const TextStyle()).copyWith(color: t.textColor), child: loading ? const SizedBox.square(dimension: 16, child: CircularProgressIndicator(strokeWidth: 2)) : child ?? const SizedBox.shrink()),
        );
        final enabled = onPressed != null && !disabled && !loading;
        return Semantics(
          button: true,
          enabled: enabled,
          child: MouseRegion(
            cursor: enabled ? SystemMouseCursors.click : SystemMouseCursors.basic,
            child: GestureDetector(onTap: enabled ? onPressed : null, child: box),
          ),
        );
      },
    );
  }
}

/// Button's design tokens: base, per-variant and per-breakpoint overrides.
class _ButtonTokens {
  const _ButtonTokens({this.backgroundColor, this.textColor, this.textStyle, this.borderColor, this.borderWidth, this.radius, this.paddingX, this.paddingY});

  final Color? backgroundColor;
  final Color? textColor;
  final TextStyle? textStyle;
  final Color? borderColor;
  final double? borderWidth;
  final double? radius;
  final double? paddingX;
  final double? paddingY;

  _ButtonTokens merge(_ButtonTokens o) => _ButtonTokens(
        backgroundColor: o.backgroundColor ?? backgroundColor,
        textColor: o.textColor ?? textColor,
        textStyle: o.textStyle ?? textStyle,
        borderColor: o.borderColor ?? borderColor,
        borderWidth: o.borderWidth ?? borderWidth,
        radius: o.radius ?? radius,
        paddingX: o.paddingX ?? paddingX,
        paddingY: o.paddingY ?? paddingY,
      );

  static const base = _ButtonTokens(
    backgroundColor: AppColors.primary,
    textColor: AppColors.surface,
    textStyle: AppTypography.labelMd,
    radius: AppRadius.md,
    paddingX: AppSpacing.md,
    paddingY: AppSpacing.sm,
  );
  static const variantPrimary = _ButtonTokens();
  static const variantSecondary = _ButtonTokens(
    backgroundColor: AppColors.surface,
    textColor: AppColors.primary,
    borderColor: AppColors.border,
    borderWidth: AppBorders.thin,
  );
  static const atTablet = _ButtonTokens(
    paddingX: AppSpacing.lg,
  );
  static const atDesktop = _ButtonTokens(
    paddingX: AppSpacing.xl,
    paddingY: AppSpacing.md,
  );

  /// Mobile-first cascade: base, then the variant, then each breakpoint the width reaches.
  static _ButtonTokens resolve(ButtonVariant variant, double width) {
    var t = base.merge(switch (variant) {
      ButtonVariant.primary => variantPrimary,
      ButtonVariant.secondary => variantSecondary,
    });
    if (width >= AppBreakpoints.tablet) t = t.merge(atTablet);
    if (width >= AppBreakpoints.desktop) t = t.merge(atDesktop);
    return t;
  }
}
