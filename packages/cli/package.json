{
  "name": "design-spec",
  "version": "0.1.0",
  "description": "The local-first design-system engine: detect, synthesize design-spec.schema.json, compile DESIGN.md/SKILL.md + framework tokens, watch, pre-commit hook, and a local MCP server that feeds AI agents only the token context they need.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "design-spec": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@design-spec/compiler": "0.3.0",
    "@inquirer/prompts": "^7.2.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ajv": "^8.17.1",
    "boxen": "^8.0.1",
    "chokidar": "^4.0.3",
    "cli-table3": "^0.6.5",
    "commander": "^13.0.0",
    "diff": "^7.0.0",
    "env-paths": "^3.0.0",
    "listr2": "^8.2.5",
    "ora": "^8.1.1",
    "picocolors": "^1.1.1",
    "update-notifier": "^7.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^25.9.1",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
